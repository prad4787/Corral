{
    "name": "corral/laravel",
    "description": "Sends queries, HTTP client calls, logs, views, cache and job events to the Corral desktop app while it runs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Corral\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Corral\\Laravel\\CorralServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
